# SentinelGraph configuration — copy to `.env` (backend) / `.env.local` (frontend).
# No secrets are required for the core pipeline. Never commit real keys.

# --- FalkorDB ---------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Optional ACL auth (leave empty when the container runs without a password):
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_NAME=sentinelgraph

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list. In production include the deployed frontend origin,
# e.g. CORS_ORIGINS=https://sentinelgraph-frontend.up.railway.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Investigation engine ---------------------------------------------------
# Maximum traversal depth for alert correlation (bounded multi-hop).
MAX_TRAVERSAL_HOPS=4
# Minimum score for a candidate alert to be grouped with the seed alert.
CORRELATION_THRESHOLD=3.0
# Minimum similarity to link an incident to a historical one.
MEMORY_SIMILARITY_THRESHOLD=0.2

# --- Optional LLM (core pipeline works with these EMPTY) --------------------
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Demo -------------------------------------------------------------------
# Seed data/demo_alerts.json automatically when the graph is empty.
# Safe in production: it only writes when the graph has zero alerts, never
# resets existing data. Use POST /demo/reset for an explicit reseed.
AUTO_SEED_ON_STARTUP=true

# --- Frontend (frontend/.env.local) -----------------------------------------
# The PUBLIC URL of the backend API, baked into the browser bundle at build
# time. Never put database credentials here — the browser only ever talks to
# the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
